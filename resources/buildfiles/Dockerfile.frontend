FROM base_image

RUN apt-get update && apt-get -y install python3 python3-pip python3-venv && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv && . /opt/venv/bin/activate && pip install flask flask-smorest flask-limiter sqlalchemy dotenv "psycopg[binary]"; deactivate

ENV VIRTUAL_ENV="/opt/venv"
ENV PATH="$PATH:/opt/venv"